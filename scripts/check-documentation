#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Source area (path prefix, from the repository root) -> module page that must be
# updated in the same change. Prefix matching is CASE-SENSITIVE (plain glob /
# grep, no -i): the rule '.../app/Display' matches the root Display*.kt files
# only, never the '.../app/display/' package, so both need their own entry.
coverage=(
  # UI, rune input, on-screen display
  'app/src/main/java/com/fieldscanner/app/MainActivity.kt|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/MainScreenView.kt|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/Display|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/display/|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/RuneActionRouter.kt|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/RuneHintPager.kt|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/runes/|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/ScannerScreenCoordinator.kt|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/ScannerScreenModel.kt|docs/modules/ui-and-input.md'
  'app/src/main/java/com/fieldscanner/app/SignalAnalysis.kt|docs/modules/ui-and-input.md'
  'app/src/main/res/layout/|docs/modules/ui-and-input.md'
  'app/src/main/res/drawable-nodpi/|docs/modules/ui-and-input.md'
  'app/src/main/assets/scan_outlines/|docs/modules/ui-and-input.md'
  'app/src/main/assets/call_contacts_family|docs/modules/ui-and-input.md'
  # Scanner flow, camera, object graph
  'app/src/main/java/com/fieldscanner/app/ScannerViewModel|docs/modules/scanner.md'
  'app/src/main/java/com/fieldscanner/app/AppContainer.kt|docs/modules/scanner.md'
  'app/src/main/java/com/fieldscanner/app/camera/|docs/modules/scanner.md'
  'app/src/main/java/com/fieldscanner/app/data/camera/|docs/modules/scanner.md'
  # Findings, journal, persistence, media, device location
  'app/src/main/java/com/fieldscanner/app/data/finding/|docs/modules/findings-and-journal.md'
  'app/src/main/java/com/fieldscanner/app/data/location/|docs/modules/findings-and-journal.md'
  'app/src/main/java/com/fieldscanner/app/journal/|docs/modules/findings-and-journal.md'
  'app/src/main/java/com/fieldscanner/app/audio/|docs/modules/findings-and-journal.md'
  # Image analysis, speech, shared networking, app language
  'app/src/main/java/com/fieldscanner/app/data/analysis/|docs/modules/ai-services.md'
  'app/src/main/java/com/fieldscanner/app/data/speech/|docs/modules/ai-services.md'
  'app/src/main/java/com/fieldscanner/app/data/net/|docs/modules/ai-services.md'
  'app/src/main/java/com/fieldscanner/app/data/diagnostics/|docs/modules/platform-and-build.md'
  'app/src/main/java/com/fieldscanner/app/voice/|docs/modules/ai-services.md'
  'app/src/main/assets/prompts/|docs/modules/ai-services.md'
  # Telephony / whitelist
  'app/src/main/java/com/fieldscanner/app/calls/|docs/modules/telephony.md'
  # Platform, manifest, build config, app resources and theme
  'app/src/main/AndroidManifest.xml|docs/modules/platform-and-build.md'
  'app/src/main/java/com/fieldscanner/app/FieldScannerApplication.kt|docs/modules/platform-and-build.md'
  'app/src/main/res/values|docs/modules/platform-and-build.md'
  'app/src/main/res/xml/|docs/modules/platform-and-build.md'
  'build.gradle|docs/modules/platform-and-build.md'
  'app/build.gradle|docs/modules/platform-and-build.md'
  'settings.gradle|docs/modules/platform-and-build.md'
  'gradle.properties|docs/modules/platform-and-build.md'
  'gradle/wrapper/|docs/modules/platform-and-build.md'
)

# Paths under app/src/main/ (and root Gradle files) that intentionally have no
# module page. Keep this list short and each entry commented.
self_check_exclusions=(
  # Launcher icon set generated by the Android Studio asset wizard.
  'app/src/main/res/mipmap-'
  'app/src/main/res/drawable/ic_launcher_background.xml'
  'app/src/main/res/drawable-v24/ic_launcher_foreground.xml'
  # Gradle wrapper launcher scripts (gradlew, gradlew.bat); the wrapper version
  # is in gradle/wrapper/ and is covered by platform-and-build.md.
  'gradlew'
)

# Pathspecs that bound both the change-gate coverage and the self-check walk.
audit_pathspecs=('app/src/main' '*.gradle' 'gradle.properties' 'gradlew' 'gradlew.bat' 'gradle/wrapper')

if [[ "${1:-}" == "--self-check" ]]; then
  candidates="$( { git ls-files -- "${audit_pathspecs[@]}"
                   git ls-files --others --exclude-standard -- "${audit_pathspecs[@]}"; } | sort -u )"
  uncovered=""
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    matched=0
    for entry in "${coverage[@]}"; do
      source_path="${entry%%|*}"
      case "$path" in "$source_path"*) matched=1; break;; esac
    done
    if (( ! matched )); then
      for prefix in "${self_check_exclusions[@]}"; do
        case "$path" in "$prefix"*) matched=1; break;; esac
      done
    fi
    (( matched )) || uncovered+="  ${path}"$'\n'
  done <<< "$candidates"

  if [[ -n "$uncovered" ]]; then
    printf 'Documentation coverage self-check: no rule or exclusion for:\n%s' "$uncovered" >&2
    printf 'Add a coverage entry (source prefix -> module page) or an explicit exclusion with a reason.\n' >&2
    exit 1
  fi
  printf 'Documentation coverage self-check: PASS\n'
  exit 0
fi

# Change-gate: union of the working tree (uncommitted + untracked) and, when a
# base ref is given, the branch commits (<base>...HEAD merge-base range).
base_ref="${1:-}"
changed="$( { git diff --name-only HEAD; git ls-files --others --exclude-standard; } | sort -u )"
if [[ -n "$base_ref" ]]; then
  changed="$( { printf '%s\n' "$changed"; git diff --name-only "$base_ref...HEAD"; } | sort -u )"
fi

missing=()
for entry in "${coverage[@]}"; do
  source_path="${entry%%|*}"
  document_path="${entry##*|}"
  if grep -q "^${source_path}" <<<"$changed" && ! grep -Fxq "$document_path" <<<"$changed"; then
    missing+=("$document_path")
  fi
done

if (( ${#missing[@]} )); then
  printf 'Documentation update required: %s\n' "$(printf '%s\n' "${missing[@]}" | sort -u | paste -sd ',')" >&2
  exit 1
fi

printf 'Documentation coverage: PASS\n'
